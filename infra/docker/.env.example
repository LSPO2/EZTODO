# EZTODO Docker Environment Configuration
# Copy this file to .env and fill in the values

# Database
POSTGRES_DB=eztodo
POSTGRES_USER=eztodo
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# API
JWT_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
AI_API_KEY=

# Ports (optional, defaults to 80/443)
HTTP_PORT=80
HTTPS_PORT=443
